---
# Rendered by lrcm.py (plain Jinja2, not by Ansible) and then applied with
# ansible-runner. Every value that could contain a colon, a hash or a brace is
# passed in pre-encoded as a JSON string, which is also a valid YAML scalar.
- name: Manage the lrcm {{ cronjob_special_time }} cronjob
  hosts: 127.0.0.1
  connection: local
  gather_facts: false
  tasks:
    # cron gives jobs without a PATH only /usr/bin:/bin, which hides ldconfig
    # and start-stop-daemon (in /usr/sbin, /sbin) from dpkg.
    - name: Manage the lrcm {{ cronjob_special_time }} cron PATH
      ansible.builtin.cron:
        name: {{ cronjob_path_name }}
        env: true
        job: {{ cronjob_path }}
        cron_file: {{ cronjob_file }}
        user: root
        state: {{ cronjob_state }}

    - name: Manage the lrcm {{ cronjob_special_time }} cron entry
      ansible.builtin.cron:
        name: {{ cronjob_name }}
        special_time: {{ cronjob_special_time }}
        user: root
        job: {{ cronjob_job }}
        cron_file: {{ cronjob_file }}
        state: {{ cronjob_state }}

    - name: Manage the lrcm {{ cronjob_special_time }} cron file permissions
      ansible.builtin.file:
        path: {{ cronjob_file_path }}
        owner: root
        group: root
        mode: "0600"
        state: {{ cronjob_file_state }}
